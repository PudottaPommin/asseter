{{- /*gotype: github.com/pudottapommin/asseter.assetsFsTemplateModel*/ -}}
// Code generated by github.com/pudottapommin/asseter; DO NOT EDIT.
//go:build bindata
package {{.Pkg}}

import (
    "bytes"
    "embed"
    "io"
    "io/fs"
    "path"
    "sync"
    "time"

    "github.com/klauspost/compress/zstd"
)

//go:embed all:{{.EmbedDir}}
var embeddedFS embed.FS

var decoderPool = sync.Pool{
    New: func() any {
        d, _ := zstd.NewReader(nil, zstd.WithDecoderConcurrency(1))
        return d
    },
}

type fileMeta struct {
    name             string
    hashedName       string
    hash             string
    embedPath        string
    isCompressed     bool
    mtime            time.Time
    uncompressedSize int64
}

var (
    hashedMap = map[string]string{
    {{- range .Files}}
        "{{.HashedName}}": "{{.Path}}",
    {{- end}}
    }

    dirs = map[string][]fs.DirEntry{
    {{- range $k, $e := .Dirs}}
        "{{$k}}": {
        {{- range $e}}
            direntry{"{{.Name}}", {{.IsDir}}, time.Unix({{.ModTime.Unix}}, 0), {{.Size}}},
        {{- end}}
        },
    {{- end}}
    }

    fileMetas = map[string]fileMeta{
    {{- range .Files}}
        "{{.Path}}": {
            name:             "{{.Name}}",
            hashedName:       "{{.HashedName}}",
            hash:             "{{.Hash}}",
            embedPath:        "{{.EmbedPath}}",
            isCompressed:     {{.IsCompressed}},
            mtime:            time.Unix({{.ModTime.Unix}}, 0),
            uncompressedSize: {{.UncompressedSize}},
        },
    {{- end}}
    }
)

type assets struct{}

var Assets = assets{}

func (a assets) Open(name string) (fs.File, error) {
    if p, ok := hashedMap[name]; ok {
        name = p
    }

    meta, ok := fileMetas[name]
    if !ok {
        if d, isDir := dirs[name]; isDir {
            return &dirFile{name: name, entries: d}, nil
        }
        return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
    }

    raw, err := embeddedFS.ReadFile(meta.embedPath)
    if err != nil {
        return nil, &fs.PathError{Op: "open", Path: name, Err: err}
    }

    if meta.isCompressed {
        dec := decoderPool.Get().(*zstd.Decoder)
        decompressed, err := dec.DecodeAll(raw, nil)
        decoderPool.Put(dec)
        if err != nil {
            return nil, &fs.PathError{Op: "open", Path: name, Err: err}
        }
        return &file{
            name:       meta.name,
            hashedName: meta.hashedName,
            hash:       meta.hash,
            mtime:      meta.mtime,
            size:       int64(len(decompressed)),
            data:       bytes.NewReader(decompressed),
            zstdData:   raw,
        }, nil
    }

    return &file{
        name:       meta.name,
        hashedName: meta.hashedName,
        hash:       meta.hash,
        mtime:      meta.mtime,
        size:       int64(len(raw)),
        data:       bytes.NewReader(raw),
    }, nil
}

func (a assets) ReadDir(name string) ([]fs.DirEntry, error) {
    if d, ok := dirs[name]; ok {
        return d, nil
    }
    return nil, &fs.PathError{Op: "readdir", Path: name, Err: fs.ErrNotExist}
}

func (a assets) HashedByPath(name string) string {
    if m, ok := fileMetas[name]; ok {
        return m.hashedName
    }
    return name
}

type dirFile struct {
    name    string
    entries []fs.DirEntry
    offset  int
}

var _ fs.ReadDirFile = (*dirFile)(nil)

func (d *dirFile) Stat() (fs.FileInfo, error) {
    return &fileinfo{name: path.Base(d.name), isDir: true, mtime: time.Time{}}, nil
}

func (d *dirFile) Read([]byte) (int, error) {
    return 0, &fs.PathError{Op: "read", Path: d.name, Err: fs.ErrInvalid}
}

func (d *dirFile) Close() error {
    return nil
}

func (d *dirFile) ReadDir(n int) ([]fs.DirEntry, error) {
    if n <= 0 {
        return d.entries, nil
    }
    if d.offset >= len(d.entries) {
        return nil, io.EOF
    }
    end := d.offset + n
    if end > len(d.entries) {
        end = len(d.entries)
    }
    res := d.entries[d.offset:end]
    d.offset = end
    return res, nil
}

type file struct {
    name       string
    hashedName string
    hash       string
    mtime      time.Time
    size       int64
    data       *bytes.Reader
    zstdData   []byte
}

var _ io.ReadSeeker = (*file)(nil)

func (f *file) Stat() (fs.FileInfo, error) {
    return &fileinfo{name: f.name, size: f.size, mtime: f.mtime, isDir: false}, nil
}

func (f *file) Read(p []byte) (int, error) {
    return f.data.Read(p)
}

func (f *file) Seek(offset int64, whence int) (int64, error) {
    return f.data.Seek(offset, whence)
}

func (f *file) Close() error {
    return nil
}

func (f *file) HashedName() string { return f.hashedName }
func (f *file) Hash() string       { return f.hash }
func (f *file) ZstdBytes() []byte  { return f.zstdData }

type fileinfo struct {
    name  string
    size  int64
    mtime time.Time
    isDir bool
}

func (f fileinfo) Name() string       { return f.name }
func (f fileinfo) Size() int64        { return f.size }
func (f fileinfo) Mode() fs.FileMode {
    if f.isDir {
        return 0o755 | fs.ModeDir
    }
    return 0o444
}
func (f fileinfo) ModTime() time.Time { return f.mtime }
func (f fileinfo) IsDir() bool        { return f.isDir }
func (f fileinfo) Sys() any           { return nil }

type direntry struct {
    name  string
    isDir bool
    mtime time.Time
    size  int64
}

func (d direntry) Name() string { return d.name }
func (d direntry) IsDir() bool  { return d.isDir }
func (d direntry) Type() fs.FileMode {
    if d.isDir {
        return 0o755 | fs.ModeDir
    }
    return 0o444
}
func (d direntry) Info() (fs.FileInfo, error) {
    return &fileinfo{name: d.name, mtime: d.mtime, size: d.size, isDir: d.isDir}, nil
}

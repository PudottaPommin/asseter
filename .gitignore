# Ignore everything by default
*

# Re-include all directories so git can traverse into them
!*/

# Repo meta
!.gitignore
!.gitattributes
!LICENSE
!README.md
!AGENTS.md
!CLAUDE.md

# Go source and module files
!*.go
!*.gotmpl
!go.mod
!go.sum

# Tooling config
!.golangci.yml
!.goreleaser.yaml
!justfile

# CI
!.github/**/*.yml
!.github/**/*.yaml

# Test fixtures (keep anything under testdata)
!testdata/**

# Exceptions: re-ignore things the allow rules would otherwise catch
/artifacts/
/vendor/
/dist/
/bin/